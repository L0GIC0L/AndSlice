diff --git a/src/libslic3r/GCode/ContourZ.cpp b/src/libslic3r/GCode/ContourZ.cpp
new file mode 100644
index 0000000..22e5539
--- /dev/null
+++ b/src/libslic3r/GCode/ContourZ.cpp
@@ -0,0 +1,144 @@
+#include "ContourZ.hpp"
+
+#include <algorithm>
+#include <cmath>
+
+#include "libslic3r/AABBMesh.hpp"
+#include "libslic3r/Layer.hpp"
+#include "libslic3r/Model.hpp"
+#include "libslic3r/Print.hpp"
+#include "libslic3r/TriangleMesh.hpp"
+
+namespace Slic3r::GCode {
+
+struct ContourZ::ObjectMesh
+{
+    indexed_triangle_set      its;
+    std::unique_ptr<AABBMesh> raycaster;
+};
+
+ContourZ::ContourZ() = default;
+ContourZ::~ContourZ() = default;
+
+const AABBMesh &ContourZ::mesh(const PrintObject &object)
+{
+    auto it = m_meshes.find(&object);
+    if (it == m_meshes.end()) {
+        // The same transformation the object is sliced with, so mesh Z matches Layer::slice_z.
+        auto mesh = std::make_unique<ObjectMesh>();
+        for (const ModelVolume *volume : object.model_object()->volumes)
+            if (volume->is_model_part()) {
+                indexed_triangle_set part = volume->mesh().its;
+                its_transform(part, object.trafo_centered() * volume->get_matrix(), true);
+                its_merge(mesh->its, part);
+            }
+        mesh->raycaster = std::make_unique<AABBMesh>(mesh->its);
+        it = m_meshes.emplace(&object, std::move(mesh)).first;
+    }
+    return *it->second->raycaster;
+}
+
+bool ContourZ::contour(const Layer &layer, const ExtrusionAttributes &attr, const Geometry::ArcWelder::Path &path,
+                       double min_z, double minimize_perimeter_angle_deg, Geometry::ArcWelder::Path &out)
+{
+    const bool perimeter = attr.role == ExtrusionRole::Perimeter || attr.role == ExtrusionRole::ExternalPerimeter;
+    const bool ironing   = attr.role == ExtrusionRole::Ironing;
+    if (!perimeter && !ironing && attr.role != ExtrusionRole::TopSolidInfill)
+        return false;
+    // Nothing below the first layer to follow, and the path must be plain lines at the layer height.
+    if (layer.lower_layer == nullptr || path.size() < 2 || attr.height <= 0.f)
+        return false;
+    for (const Geometry::ArcWelder::Segment &segment : path)
+        if (!segment.linear() || segment.height_fraction != 1.f || segment.e_fraction != 1.f)
+            return false;
+
+    const AABBMesh &object_mesh = this->mesh(*layer.object());
+    const double height     = layer.height;
+    min_z                   = std::clamp(min_z, 0.01, height);
+    const double max_up     = min_z;
+    const double min_down   = -(height - min_z);
+    // Layer::slice_z is the middle of the layer.
+    const double top        = 0.5 * height;
+    const double half_width = 0.5 * attr.width;
+    const double resolution = 0.1; // mm between the sampled points
+
+    // Offset of the nozzle from the layer top at a point of this layer, in mm.
+    auto offset_at = [&](const Vec2d &p) {
+        const AABBMesh::hit_result hit = object_mesh.query_ray_hit(Vec3d(p.x(), p.y(), layer.slice_z), Vec3d::UnitZ());
+        if (!hit.is_hit())
+            return 0.;
+        double d = hit.distance() - top;
+        if (perimeter && d > min_down && minimize_perimeter_angle_deg > 0.) {
+            // Lower the walls on steep slopes so their edge does not stand out.
+            const double slope = std::acos(std::min(1., std::abs(hit.normal().normalized().z())));
+            if (slope * 180. / M_PI > minimize_perimeter_angle_deg)
+                d = std::max(d - half_width * std::sin(slope), min_down);
+        }
+        if (d < -height || d > max_up + 0.03)
+            // Too far from a top surface: inside the object or under another layer.
+            return 0.;
+        d = std::clamp(d, min_down, max_up);
+        if (perimeter && d > 0.)
+            // Raised walls would show as a seam.
+            d = 0.;
+        return d;
+    };
+
+    out.clear();
+    out.reserve(path.size() * 2);
+    // Points of the original path stay, so its outline does not change; sampled points are
+    // dropped where they lie on the line between their neighbors.
+    std::vector<bool> original;
+    auto add = [&](const Point &point, double d, bool keep) {
+        Geometry::ArcWelder::Segment segment;
+        segment.point           = point;
+        segment.height_fraction = float(1. + d / attr.height);
+        if (out.size() >= 2 && !original.back()) {
+            const Geometry::ArcWelder::Segment &a = out[out.size() - 2], &b = out.back();
+            auto to3d = [&attr](const Geometry::ArcWelder::Segment &s) {
+                return Vec3d(unscaled<double>(s.point.x()), unscaled<double>(s.point.y()), (s.height_fraction - 1.) * attr.height);
+            };
+            const Vec3d pa = to3d(a), pb = to3d(b), pc = to3d(segment);
+            const Vec3d ac = pc - pa;
+            const double len2 = ac.squaredNorm();
+            if (len2 > 0.) {
+                const double t = std::clamp((pb - pa).dot(ac) / len2, 0., 1.);
+                if ((pa + ac * t - pb).squaredNorm() < 1e-6) {
+                    out.back()      = segment;
+                    original.back() = keep;
+                    return;
+                }
+            }
+        }
+        out.push_back(segment);
+        original.push_back(keep);
+    };
+
+    bool contoured = false;
+    {
+        const double d = offset_at(unscaled<double>(path.front().point));
+        contoured |= std::abs(d) > EPSILON;
+        add(path.front().point, d, true);
+    }
+    for (size_t i = 1; i < path.size(); ++i) {
+        const Vec2d a = unscaled<double>(path[i - 1].point);
+        const Vec2d b = unscaled<double>(path[i].point);
+        const int   n = std::max(1, int(std::ceil((b - a).norm() / resolution)));
+        for (int k = 1; k <= n; ++k) {
+            const bool  last  = k == n;
+            const Vec2d p     = last ? b : Vec2d(a + (b - a) * (double(k) / n));
+            const double d    = offset_at(p);
+            contoured |= std::abs(d) > EPSILON;
+            add(last ? path[i].point : Point::new_scale(p.x(), p.y()), d, last);
+        }
+    }
+    if (!contoured)
+        return false;
+
+    // Flow follows the local layer height, averaged over each move. Ironing hardly extrudes, so it keeps its flow.
+    for (size_t i = 1; i < out.size(); ++i)
+        out[i].e_fraction = ironing ? 1.f : 0.5f * (out[i - 1].height_fraction + out[i].height_fraction);
+    return true;
+}
+
+} // namespace Slic3r::GCode
diff --git a/src/libslic3r/GCode/ContourZ.hpp b/src/libslic3r/GCode/ContourZ.hpp
new file mode 100644
index 0000000..df9e247
--- /dev/null
+++ b/src/libslic3r/GCode/ContourZ.hpp
@@ -0,0 +1,47 @@
+#ifndef slic3r_GCode_ContourZ_hpp_
+#define slic3r_GCode_ContourZ_hpp_
+
+#include <map>
+#include <memory>
+
+#include "libslic3r/ExtrusionEntity.hpp"
+#include "libslic3r/Geometry/ArcWelder.hpp"
+
+namespace Slic3r {
+
+class AABBMesh;
+class Layer;
+class PrintObject;
+
+namespace GCode {
+
+// Z anti-aliasing: lets top surfaces and the walls under them follow the model's sloped and curved
+// tops instead of the layer plane. Ported from OrcaSlicer's Z contouring (ContourZ.cpp by adob),
+// which raises or lowers every extrusion point to where a vertical ray from the slicing plane hits
+// the object's mesh. Here the offsets go into the per-point height and flow fractions of the smooth
+// path that PrusaSlicer already uses for scarf seams, so only G-code emission needs to know about it.
+class ContourZ
+{
+public:
+    ContourZ();
+    ~ContourZ();
+
+    // Resamples `path` of `layer` and stores the Z offset of every point in its height_fraction
+    // (relative to attr.height) and the matching flow in its e_fraction. Returns false and leaves
+    // `out` unspecified when the path is not changed.
+    bool contour(const Layer &layer, const ExtrusionAttributes &attr, const Geometry::ArcWelder::Path &path,
+                 double min_z, double minimize_perimeter_angle_deg, Geometry::ArcWelder::Path &out);
+
+private:
+    const AABBMesh &mesh(const PrintObject &object);
+
+    // Model parts of each object in the object's slicing coordinates. AABBMesh keeps a pointer
+    // to the triangles, so they live next to it.
+    struct ObjectMesh;
+    std::map<const PrintObject*, std::unique_ptr<ObjectMesh>> m_meshes;
+};
+
+} // namespace GCode
+} // namespace Slic3r
+
+#endif // slic3r_GCode_ContourZ_hpp_
