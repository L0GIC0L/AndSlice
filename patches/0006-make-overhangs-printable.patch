diff --git a/src/libslic3r/PrintObjectSlice.cpp b/src/libslic3r/PrintObjectSlice.cpp
index 2059589..024b25d 100644
--- a/src/libslic3r/PrintObjectSlice.cpp
+++ b/src/libslic3r/PrintObjectSlice.cpp
@@ -868,6 +868,75 @@ void apply_fuzzy_skin_segmentation(PrintObject &print_object, ThrowOnCancel thro
 // Resulting expolygons of layer regions are marked as Internal.
 //
 // this should be idempotent
+// Make overhangs printable, ported from OrcaSlicer's PrintObject::apply_conical_overhang(), which ports
+// CuraEngine's ConicalOverhang. From the top down, each layer gets the layer above it, shrunk by how far an
+// overhang at the maximum angle may reach over one layer, so steeper overhangs become slopes of material.
+void PrintObject::apply_conical_overhang()
+{
+    if (m_layers.empty())
+        return;
+    const double angle = m_config.make_overhang_printable_angle.value;
+    if (angle >= 90.)
+        return;
+    BOOST_LOG_TRIVIAL(debug) << "Slicing volumes - make overhangs printable";
+    const double tan_angle            = std::tan(angle * M_PI / 180.);
+    const double scaled_max_hole_area = scale_(scale_(m_config.make_overhang_printable_hole_size.value));
+
+    for (auto it = m_layers.rbegin() + 1; it != m_layers.rend(); ++ it) {
+        m_print->throw_if_canceled();
+        Layer *layer       = *it;
+        Layer *upper_layer = layer->upper_layer;
+        if (upper_layer == nullptr || upper_layer->empty())
+            continue;
+        // Skip layers where every region has it off.
+        if (std::all_of(layer->m_regions.begin(), layer->m_regions.end(),
+                        [](const LayerRegion *r) { return r->slices().empty() || !r->region().config().make_overhang_printable; }))
+            continue;
+
+        // Whole layers are offset, so the model does not break where regions meet.
+        ExPolygons upper_poly   = union_ex(upper_layer->merged(float(SCALED_EPSILON)));
+        ExPolygons current_poly = union_ex(layer->merged(float(SCALED_EPSILON)));
+
+        // Holes in the base of the model up to the given area keep their opening: a hole the layer above
+        // covers completely is the top of such a hole, and is cut from the layer above before it is added.
+        if (scaled_max_hole_area > 0.) {
+            for (const ExPolygon &layer_polygon : current_poly)
+                for (const Polygon &hole : layer_polygon.holes)
+                    if (std::abs(hole.area()) < scaled_max_hole_area) {
+                        const ExPolygon hole_poly(hole);
+                        const ExPolygons hole_with_above = intersection_ex(upper_poly, hole_poly);
+                        if (! hole_with_above.empty() && xor_ex(hole_with_above, hole_poly).empty())
+                            upper_poly = diff_ex(upper_poly, ExPolygons{ hole_poly });
+                    }
+        }
+
+        // How far the layer above may overhang this one; the layer's own height, so variable layer
+        // heights keep the angle.
+        upper_poly = offset_ex(upper_poly, -float(scale_(tan_angle * upper_layer->height)));
+
+        for (size_t region_id = 0; region_id < this->num_printing_regions(); ++ region_id) {
+            if (! upper_layer->m_regions[region_id]->region().config().make_overhang_printable)
+                continue;
+            // The part of the shrunk layer above that belongs to this region.
+            ExPolygons p = union_ex(intersection_ex(upper_layer->m_regions[region_id]->slices().surfaces, upper_poly));
+            // Islands this layer already covers add nothing.
+            p.erase(std::remove_if(p.begin(), p.end(), [&current_poly](const ExPolygon &ex) { return diff_ex(ex, current_poly).empty(); }),
+                    p.end());
+            if (p.empty())
+                continue;
+            ExPolygons layer_polygons = to_expolygons(layer->m_regions[region_id]->slices().surfaces);
+            layer->m_regions[region_id]->m_slices.set(union_ex(layer_polygons, p), stInternal);
+            // And taken out of the other regions, so they do not overlap.
+            for (size_t other_region = 0; other_region < this->num_printing_regions(); ++ other_region) {
+                if (other_region == region_id)
+                    continue;
+                ExPolygons s = to_expolygons(layer->m_regions[other_region]->slices().surfaces);
+                layer->m_regions[other_region]->m_slices.set(diff_ex(s, p, ApplySafetyOffset::Yes), stInternal);
+            }
+        }
+    }
+}
